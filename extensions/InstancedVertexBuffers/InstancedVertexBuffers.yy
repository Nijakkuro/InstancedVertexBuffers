        {"$GMExtensionFunction":"","%Name":"_ivb_make_detailed_format_info","argCount":0,"args":[2,2,],"documentation":"","externalName":"_ivb_make_detailed_format_info","help":"_ivb_make_detailed_format_info(format, instance_attrib_num)","hidden":true,"kind":2,"name":"_ivb_make_detailed_format_info","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"_ivb_format_get_instance_data_size","argCount":0,"args":[2,2,],"documentation":"","externalName":"_ivb_format_get_instance_data_size","help":"_ivb_format_get_instance_data_size(format, instance_attrib_num)","hidden":true,"kind":2,"name":"_ivb_format_get_instance_data_size","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_vertex_buffer_create","argCount":0,"args":[2,2,2,2,2,],"documentation":"/// @description    Creates a new instanced vertex buffer by copying the data from the specified source buffer.\r\n/// @param {Id.Buffer}     buffer    The buffer to create the vertex buffer from.\r\n/// @param {Id.VertexFormat}    format    The vertex format to use.\r\n/// @param {Id.Real}    instance_attrib_num    The number of last attributes in vertex format to use as instance data.\r\n/// @param {Id.Real}    src_offset    The offset within the source buffer to copy from.\r\n/// @param {Id.Real}    vert_num    The number of vertices the vertex buffer should have.\r\n/// @return {Id.InstancedVertexBuffer}","externalName":"ivb_vertex_buffer_create","help":"ivb_vertex_buffer_create(buffer, format, instance_attrib_num, src_offset, vert_num)","hidden":false,"kind":2,"name":"ivb_vertex_buffer_create","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_vertex_buffer_delete","argCount":0,"args":[2,],"documentation":"/// @description    This function removes a previously created instanced vertex buffer from system memory.\r\n/// @param {Id.InstancedVertexBuffer}     instanced_vbuffer","externalName":"ivb_vertex_buffer_delete","help":"ivb_vertex_buffer_delete(instanced_vbuffer)","hidden":false,"kind":2,"name":"ivb_vertex_buffer_delete","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_vertex_buffer_submit","argCount":0,"args":[2,2,2,2,2,],"documentation":"/// @description    This function submits the contents of a vertex buffer and an instance buffer to the graphics pipeline for use with a shader.\r\n/// @param {Id.InstancedVertexBuffer}     instanced_vbuffer    The instanced vertex buffer to use.\r\n/// @param {Constant.PrimitiveType}    format    The primitive base type.\r\n/// @param {Id.Texture}    texture    The texture to use (or -1 for no texture).\r\n/// @param {Id.InstanceBuffer}    instance_buffer    The instance buffer to use.\r\n/// @param {Id.Real}    inst_num    The number of instances. Pass -1 to use all instances from the instance buffer.","externalName":"ivb_vertex_buffer_submit","help":"ivb_vertex_buffer_submit(instanced_vbuffer, primtype, texture, instance_buffer, inst_num)","hidden":false,"kind":2,"name":"ivb_vertex_buffer_submit","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_vertex_buffer_get_vert_data_size","argCount":0,"args":[2,],"documentation":"/// @description    Returns the data size of one vertex, in bytes, from the specified instanced vertex buffer.\r\n/// @param {Id.IvbInstanceBuffer}     instanced_vbuffer\r\n/// @return {Real}","externalName":"ivb_vertex_buffer_get_vert_data_size","help":"ivb_vertex_buffer_get_vert_data_size(instanced_vbuffer)","hidden":false,"kind":2,"name":"ivb_vertex_buffer_get_vert_data_size","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_vertex_buffer_get_inst_data_size","argCount":0,"args":[2,],"documentation":"/// @description    Returns the data size of one instance, in bytes, from the specified instanced vertex buffer.\r\n/// @param {Id.IvbInstanceBuffer}     instanced_vbuffer\r\n/// @return {Real}","externalName":"ivb_vertex_buffer_get_inst_data_size","help":"ivb_vertex_buffer_get_inst_data_size(instanced_vbuffer)","hidden":false,"kind":2,"name":"ivb_vertex_buffer_get_inst_data_size","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_instance_buffer_create","argCount":0,"args":[2,2,2,2,2,],"documentation":"/// @description    Creates a new instance buffer by copying the data from the specified source buffer.\r\n/// @param {Id.Buffer}     buffer    The buffer to create the vertex buffer from. Use -1 if you just want to reserve memory and fill it later with the ivb_instance_buffer_update function.\r\n/// @param {Id.VertexFormat}    format    The vertex format to use.\r\n/// @param {Id.Real}    instance_attrib_num    The number of last attributes in vertex format to use as instance data.\r\n/// @param {Id.Real}    src_offset    The offset in bytes in the source buffer to start copying.\r\n/// @param {Id.Real}    instance_num    The number of instances the instance buffer should have.\r\n/// @return {Id.InstanceBuffer}","externalName":"ivb_instance_buffer_create","help":"ivb_instance_buffer_create(buffer, format, instance_attrib_num, src_offset, instance_num)","hidden":false,"kind":2,"name":"ivb_instance_buffer_create","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_instance_buffer_update","argCount":0,"args":[2,2,2,2,2,],"documentation":"/// @description    Updates an instance buffer by copying the data from the specified source buffer.\r\n/// @param {Id.InstanceBuffer}     dest_instbuff    The instance buffer to copy to.\r\n/// @param {Id.Real}     dest_offset    The offset in the destination buffer to start writing the data.\r\n/// @param {Id.Buffer}     src_buffer    The buffer to copy from.\r\n/// @param {Id.Real}    src_offset    The offset in bytes in the source buffer to start copying.\r\n/// @param {Id.Real}    src_size    The size of the data in bytes to copy from the source buffer. When -1 the whole buffer is copied.","externalName":"ivb_instance_buffer_update","help":"ivb_instance_buffer_update(dest_instbuff, dest_offset, src_buffer, src_offset, src_size)","hidden":false,"kind":2,"name":"ivb_instance_buffer_update","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_instance_buffer_delete","argCount":0,"args":[2,],"documentation":"/// @description    This function removes a previously created instance buffer from system memory.\r\n/// @param {Id.InstanceBuffer}     instance_buffer","externalName":"ivb_instance_buffer_delete","help":"ivb_instance_buffer_delete(instance_buffer)","hidden":false,"kind":2,"name":"ivb_instance_buffer_delete","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"ivb_instance_buffer_get_inst_data_size","argCount":0,"args":[2,],"documentation":"/// @description    Returns the data size of one instance, in bytes, from the specified instance buffer.\r\n/// @param {Id.IvbInstanceBuffer}     instance_buffer\r\n/// @return {Real}","externalName":"ivb_instance_buffer_get_inst_data_size","help":"ivb_instance_buffer_get_inst_data_size(instance_buffer)","hidden":false,"kind":2,"name":"ivb_instance_buffer_get_inst_data_size","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
